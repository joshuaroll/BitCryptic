  "font": {
    "$description": "In-art type (decision 2026-10, design-system desk). Two stacks and nothing else: the scene lint errors on any other font-family in scenes/. clue = clue text and anything a machine, screen, plate or sign shows. paper = anything written on or cut into a material: paper, parchment, chalk, books, carved, engraved or scratched text. A clue on paper or stone takes paper (the surface decides). JetBrains Mono is loaded by index.html; Georgia is a system font. 'Fredoka One' was never loaded and fell back to Comic Sans: never use it.",
    "clue": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "monospace"],
      "$description": "Clue and machine text. SVG attribute form: font-family=\"'JetBrains Mono',monospace\". Monospace needs no letter-spacing."
    },
    "paper": {
      "$type": "fontFamily",
      "$value": ["Georgia", "serif"],
      "$description": "Paper and carving. SVG attribute form: font-family=\"Georgia,serif\"."
    }
  },
  "light": {
    "$description": "One key light for every scene, from the UPPER LEFT, unless a scene overrides (opts.light). Lit faces face left and up; the shade band sits on the right. Shade leans cool toward ink, highlight leans warm.",
    "side": {
      "$type": "string",
      "$value": "left",
      "$description": "left | right: the side the key light comes from."
    },
    "elevation": {
      "$type": "number",
      "$value": 55,
      "$description": "Degrees above the horizon. Tops of boxes are lit, undersides are shade."
    },
    "shade": {
      "$type": "number",
      "$value": 0.26,
      "$description": "tone().shade = base mixed this far toward shadeTint."
    },
    "highlight": {
      "$type": "number",
      "$value": 0.22,
      "$description": "tone().hi = base mixed this far toward hiTint."
    },
    "shadeTint": {
      "$type": "color",
      "$value": "#0B1021",
      "$description": "Shadows lean toward brand ink, never toward grey."
    },
    "hiTint": {
      "$type": "color",
      "$value": "#fff3d6",
      "$description": "Highlights lean warm."
    }
  },
  "outline": {
    "$description": "Croc-style ink line. Colour = the shape's own base darkened toward ink (never one flat black). Width is in SCENE units after scale, so a scaled prop keeps a constant line. bg and far get no outline: line weight is a depth cue.",
    "ink": {
      "$type": "number",
      "$value": 0.62,
      "$description": "ink(hex) = hex mixed this far toward light.shadeTint."
    },
    "width": {
      "fg": {
        "$type": "number",
        "$value": 1.6,
