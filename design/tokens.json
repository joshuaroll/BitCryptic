{
  "$description": "Bit Cryptic World scene tokens, W3C Design Tokens format (2025.10). Read by Scene Studio, the scene lint and the art kit (scenes/art-kit.js embeds a generated copy: run node scripts/build-art-tokens.cjs after editing). Scale and motion keep the cast consistent. palette/light/outline/depth/contact are the art-kit style: they are DERIVED from the colours the best shipped scenes already use, so new art matches old. They are a reference for new kit props, never a licence to sweep existing scene colours (scene-art rule 6).",
  "scale": {
    "reference": {
      "$type": "number",
      "$value": 166,
      "$description": "Standing height, in scene units, of a cast-ratio-1.0 character whose feet are on the near floor. Calibrated on wreck_3: the approved Fredward at the deck, same height as the canonical h=21 rig."
    },
    "nearFloor": {
      "$type": "number",
      "$value": 236,
      "$description": "Floor y the reference height is measured at."
    },
    "cast": {
      "$description": "Relative standing height of each character against Fredward. Expected height = reference x cast x (floorY - horizon) / (nearFloor - horizon).",
      "fredward": {
        "$type": "number",
        "$value": 1.0
      },
      "webby": {
        "$type": "number",
        "$value": 1.0
      },
      "croc": {
        "$type": "number",
        "$value": 0.92
      },
      "harrington": {
        "$type": "number",
        "$value": 1.1
      },
      "laurel": {
        "$type": "number",
        "$value": 1.1
      },
      "dock-keeper": {
        "$type": "number",
        "$value": 1.0
      },
      "barista": {
        "$type": "number",
        "$value": 0.95
      },
      "librarian": {
        "$type": "number",
        "$value": 1.05
      },
      "star-watcher": {
        "$type": "number",
        "$value": 1.05
      },
      "wren": {
        "$type": "number",
        "$value": 0.85
      }
    }
  },
  "shadow": {
    "rxPerHeight": {
      "$type": "number",
      "$value": 0.22
    },
    "opacity": {
      "$type": "number",
      "$value": 0.32
    },
    "color": {
      "$type": "color",
      "$value": "#0a0806"
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.42,
        0,
        0.58,
        1
      ],
      "$description": "Symmetric ease-in-out for every organic loop."
    },
    "breathMin": {
      "$type": "duration",
      "$value": {
        "value": 3.75,
        "unit": "s"
      }
    },
    "breathMax": {
      "$type": "duration",
      "$value": {
        "value": 5,
        "unit": "s"
      }
    },
    "breathKeyTimes": {
      "$type": "string",
      "$value": "0; 0.333; 1",
      "$description": "Inhale:exhale 1:2. Symmetric 0;0.5;1 reads as a machine."
    }
  },
  "palette": {
    "$description": "Art palette. 'brand' is Dusk Terminal (chrome only; art may borrow ink/amber/mint as accents). 'shared' holds colours every biome uses (Croc gold, ceramic, paper), plus the eight device hues and two fishing-rarity hues signed off for use outside /field-guide. Every biome defines the SAME roles, so a prop asks for a role (wood, stone, foliage...) and gets that biome's colour. haze = the ambient medium colour depth veils toward.",
